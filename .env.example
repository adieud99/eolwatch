DATABASE_URL=postgresql+psycopg://eolwatch:eolwatch@db:5432/eolwatch
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SSH_PRIVATE_KEY_PATH=/run/secrets/eolwatch_ssh_key
SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts
SSH_STRICT_HOST_KEY=true
SSH_CONNECT_TIMEOUT_SECONDS=10
COLLECTION_HOUR=8
COLLECTION_MINUTE=30
SCHEDULER_TIMEZONE=Asia/Seoul
AUTO_CREATE_SCHEMA=true
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
PUBLIC_BASE_URL=http://localhost:8080
DEMO_TARGET_IPS=
# AI: 기본은 OpenAI. 키는 이 파일에만 적는다. 모델은 OPENAI_MODEL로 고른다.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 숨은 추론(thinking) 토큰 끄기. 모델이 값을 거부하면 자동으로 빼고 다시 보낸다. 추론이 필요하면 low/medium/high.
OPENAI_REASONING_EFFORT=none
# Claude를 쓰려면 AI_PROVIDER=anthropic 으로 바꾸고 키를 넣는다.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# 파이프라인 AI(잠금 파일 없는 소스의 라이브러리 참조, SSH 수집 에이전트). false면 끈다.
AI_PIPELINE=true
# SSH 비밀번호 인증을 쓸 때 비밀번호 암호화 키 (비우면 JWT_SECRET 사용)
CREDENTIAL_KEY=
